# The Observer US — environment variables (copy to /opt/observer/.env on the VM)
# NEVER commit a filled-in .env — values live only on the server.
# See deploy/oracle/README.md for the deploy setup.

# --- Site ---
# Public URL of the live site (used for canonical URLs, sitemaps, OG tags)
NEXT_PUBLIC_SITE_URL=https://theobserverus.com
SITE_URL=https://theobserverus.com
NODE_ENV=production

# --- Database (Payload CMS content lives here) ---
# Neon free Postgres. Payload prefers the unpooled connection for
# transactions/migrations; the pooled URL also works for reads.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
# DATABASE_URI=  (alternative name, same value as DATABASE_URL)
# POSTGRES_URL_NON_POOLING=  (alternative name)

# --- Payload CMS ---
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Secrets for API routes ---
CRON_SECRET=change-me
REVALIDATION_SECRET=change-me

# --- Email (Resend) ---
RESEND_API_KEY=re_...

# --- Web push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Subscribers (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Search indexing ---
INDEXNOW_KEY=
# IndexNow key file must exist at public/{INDEXNOW_KEY}.txt (already added:
# fda02fc283c806745165f922799b20fa). Set this to that same key on the VM.

# --- Analytics (Google Analytics 4, optional) ---
# Create a GA4 property at analytics.google.com and paste its measurement ID.
# Until this is set, no Google Analytics loads and the site stays
# first-party-analytics-only. Required later for Journey by Mediavine / Raptive.
NEXT_PUBLIC_GA_ID=

# --- CMS API (only needed if the frontend reads a remote CMS instead of
# the local Payload instance; leave empty to use the local Payload API.
# WARNING: if CMS_API_URL is unset, the site falls back to mock data in
# development — production must always have the real CMS configured.) ---
# CMS_API_URL=
# CMS_API_KEY=

# --- Logging ---
LOG_LEVEL=info
